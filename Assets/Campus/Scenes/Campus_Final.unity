  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NarrationManager
  _masterVoiceVolume: 1
  _narrationEntries:
  - id: campus_gate_welded
    clip: {fileID: 0}
    volume: 1
    subtitleText: Welded. From the outside... somebody wanted us kept in. There was an old service gate - the far south-east corner, past the student centre. The control room upstairs could open it.
  - id: campus_service_gate_found
    clip: {fileID: 0}
    volume: 1
    subtitleText: That's it - the service gate. The lock's magnetic. Someone has to release it from the control room.
  _showSubtitles: 1
  _subtitlePaddingBottom: 65
